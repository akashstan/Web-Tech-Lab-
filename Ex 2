<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Profile</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #eaf4ff;
        }

        header {
            background-color: #123b63;
            color: white;
            text-align: center;
            padding: 20px;
        }

        nav {
            background-color: #2f6f9f;
            text-align: center;
            padding: 12px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 20px;
            font-weight: bold;
        }

        .container {
            width: 85%;
            margin: 20px auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
        }

        .profile {
            text-align: center;
        }

        .profile img {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 4px solid #2f6f9f;
        }

        h2 {
            color: #123b63;
            border-bottom: 2px solid #2f6f9f;
            padding-bottom: 5px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        table, th, td {
            border: 1px solid black;
        }

        th {
            background-color: #2f6f9f;
            color: white;
        }

        th, td {
            padding: 10px;
            text-align: center;
        }

        fieldset {
            margin-top: 20px;
            padding: 20px;
            border: 2px solid #2f6f9f;
        }

        legend {
            font-weight: bold;
            color: #123b63;
        }

        label {
            display: inline-block;
            width: 180px;
            margin-top: 10px;
        }

        input, select, textarea {
            padding: 7px;
            margin-top: 8px;
        }

        textarea {
            width: 60%;
        }

        .media {
            text-align: center;
        }

        button, input[type="submit"], input[type="reset"] {
            background-color: #123b63;
            color: white;
            border: none;
            padding: 10px 20px;
            margin: 10px;
            cursor: pointer;
        }

        footer {
            background-color: #123b63;
            color: white;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>

<body>

    <header>
        <h1>Student Profile</h1>
        <p>Karunya Institute of Technology and Sciences</p>
    </header>

    <nav>
        <a href="https://in.linkedin.com/in/akash-stanley-a68899328">Profile</a>
        <a href="https://www.karunya.edu/">Academics</a>
        <a href="https://www.credly.com/badges/4ed9c76e-f348-4080-ba59-63265d204ceb">Achievements</a>
    </nav>

    <div class="container">

        <div class="profile">

            <img src="Photo.jpeg" alt="Student Profile Photo">

            <h2>S A Akash</h2>

            <a href="https://www.karunya.edu/" target="_blank">
                Visit Karunya University Website
            </a>

        </div>

        <div id="academics">

            <h2>Academic Information</h2>

            <table>

                <tr>
                    <th>Course</th>
                    <th>Semester</th>
                    <th>Grade</th>
                </tr>

                <tr>
                    <td>Web Technology</td>
                    <td>III</td>
                    <td>A</td>
                </tr>

                <tr>
                    <td>Java Programming</td>
                    <td>III</td>
                    <td>A+</td>
                </tr>

                <tr>
                    <td>Python Programming</td>
                    <td>III</td>
                    <td>A</td>
                </tr>

            </table>

            <br>

            <label>Course Progress:</label>

            <progress value="75" max="100">
                75%
            </progress>

            75%

        </div>

        <div id="achievements">

            <h2>Achievements and Skills</h2>

            <ul>
                <li>NPTEL Certifications</li>
                <li>Mindkraft Competition</li>
            </ul>

            <p>
                Skills:
                HTML, CSS, Java, C, Python and JavaScript
            </p>

        </div>

        <div id="media" class="media">

            <h2>HTML5 Media Elements</h2>

            <h3>Audio</h3>

            <audio controls>

                <source src="Audio.mp3" type="audio/mpeg">

                Your browser does not support audio.

            </audio>

            <h3>Video</h3>

            <video width="450" controls>

                <source src="Video.mp4" type="video/mp4">

                Your browser does not support video.

            </video>

            <h3>Embedded Document</h3>

            <embed
                src="Ex 1.pdf"
                width="500"
                height="300"
                type="application/pdf">

            <h3>Karunya Website Using Iframe</h3>

            <iframe
                src="https://www.google.com/maps?q=Karunya%20Institute%20of%20Technology%20and%20Sciences&output=embed"
                width="700"
                height="350"
                title="Karunya University Website">

            </iframe>

        </div>

        <div id="registration">

            <h2>Student Details</h2>

            <form action="/action_page.php" method="get">

                <fieldset>

                    <legend>Personal Information</legend>

                    <label for="username">
                        Username:
                    </label>

                    <input
                        type="text"
                        id="username"
                        name="username"
                        placeholder="Enter username"
                        required>

                    <br>

                    <label for="password">
                        Password:
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter password"
                        required>

                    <br>

                    <label for="regno">
                        Register Number:
                    </label>

                    <input
                        type="text"
                        id="regno"
                        name="regno"
                        placeholder="Enter register number"
                        required>

                    <br>

                    <label for="age">
                        Age:
                    </label>

                    <input
                        type="number"
                        id="age"
                        name="age"
                        min="18"
                        max="30">

                    <br>

                    <label>
                        Gender:
                    </label>

                    <input
                        type="radio"
                        name="gender"
                        value="Male">

                    Male

                    <input
                        type="radio"
                        name="gender"
                        value="Female">

                    Female

                    <br>

                    <label for="dob">
                        Date of Birth:
                    </label>

                    <input
                        type="date"
                        id="dob"
                        name="dob">

                    <br>

                    <label for="color">
                        Favorite Color:
                    </label>

                    <input
                        type="color"
                        id="color"
                        name="color">

                    <br>

                    <label for="photo">
                        Change Profile Photo:
                    </label>

                    <input
                        type="file"
                        id="photo"
                        name="photo">

                </fieldset>

                <fieldset>

                    <legend>Contact Information</legend>

                    <label for="address">
                        Address:
                    </label>

                    <textarea
                        id="address"
                        name="address"
                        rows="4"
                        cols="40"
                        placeholder="Enter your address">
                    </textarea>

                    <br>

                    <label for="state">
                        State:
                    </label>

                    <select id="state" name="state">

                        <option value="">
                            Select State
                        </option>

                        <option value="Tamil Nadu">
                            Tamil Nadu
                        </option>

                        <option value="Kerala">
                            Kerala
                        </option>

                        <option value="Karnataka">
                            Karnataka
                        </option>

                        <option value="Andhra Pradesh">
                            Andhra Pradesh
                        </option>

                    </select>

                    <br>

                    <label for="zipcode">
                        Zip Code:
                    </label>

                    <input
                        type="number"
                        id="zipcode"
                        name="zipcode"
                        placeholder="Enter zip code">

                    <br>

                    <label for="mobile">
                        Mobile Number:
                    </label>

                    <input
                        type="tel"
                        id="mobile"
                        name="mobile"
                        placeholder="Enter mobile number">

                    <br>

                    <label for="email">
                        Email:
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter email">

                    <br>

                    <label for="website">
                        Website URL:
                    </label>

                    <input
                        type="url"
                        id="website"
                        name="website"
                        placeholder="Enter website URL">

                </fieldset>

                <fieldset>

                    <legend>Additional Details</legend>

                    <label for="search">
                        Search:
                    </label>

                    <input
                        type="search"
                        id="search"
                        name="search">

                    <br>

                    <label for="range">
                        Skill Level:
                    </label>

                    <input
                        type="range"
                        id="range"
                        name="range"
                        min="0"
                        max="10">

                    <br>

                    <label>
                        Interested Subjects:
                    </label>

                    <input
                        type="checkbox"
                        name="subject"
                        value="HTML">

                    HTML

                    <input
                        type="checkbox"
                        name="subject"
                        value="Java">

                    Java

                    <input
                        type="checkbox"
                        name="subject"
                        value="Python">

                    Python

                    <br>

                    <input
                        type="hidden"
                        name="formid"
                        value="student_form">

                </fieldset>

                <center>

                    <input
                        type="submit"
                        value="Submit">

                    <input
                        type="reset"
                        value="Reset">

                    <input
                        type="button"
                        value="Click Here"
                        onclick="alert('Welcome to the Student Profile Page!')">

                </center>

            </form>

        </div>

    </div>

    <footer>

        <p>
            © 2026 Student Profile |
            Karunya Institute of Technology and Sciences |
            All Rights Reserved.
        </p>

    </footer>

</body>

</html>

