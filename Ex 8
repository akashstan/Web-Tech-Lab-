import { useState } from "react";
import "./App.css";

function App() {
  const [darkMode, setDarkMode] = useState(false);
  const [menuOpen, setMenuOpen] = useState(false);
  const [search, setSearch] = useState("");
  const [task, setTask] = useState("");
  const [imageError, setImageError] = useState(false);

  const [tasks, setTasks] = useState([
    { id: 1, text: "Complete React assignment", done: false },
    { id: 2, text: "Study database management", done: true },
  ]);

  const courses = [
    { name: "Web Technology", progress: 80 },
    { name: "Database Management", progress: 65 },
    { name: "Machine Learning", progress: 45 },
    { name: "Computer Networks", progress: 90 },
  ];

  const filteredCourses = courses.filter((course) =>
    course.name.toLowerCase().includes(search.toLowerCase())
  );

  const filteredTasks = tasks.filter((item) =>
    item.text.toLowerCase().includes(search.toLowerCase())
  );

  function addTask() {
    if (task.trim() !== "") {
      setTasks([
        ...tasks,
        {
          id: Date.now(),
          text: task.trim(),
          done: false,
        },
      ]);
      setTask("");
    }
  }

  function toggleTask(id) {
    setTasks(
      tasks.map((item) =>
        item.id === id
          ? { ...item, done: !item.done }
          : item
      )
    );
  }

  function deleteTask(id) {
    setTasks(tasks.filter((item) => item.id !== id));
  }

  const pendingTasks = tasks.filter((item) => !item.done).length;
  const completedTasks = tasks.filter((item) => item.done).length;

  return (
    <div className={darkMode ? "app dark" : "app"}>
      <header className="topbar">
        <button
          className="menu-toggle"
          onClick={() => setMenuOpen(!menuOpen)}
          aria-label="Toggle navigation menu"
        >
          ☰
        </button>

        <h2 className="logo">EduDashboard URK24CS1166</h2>

        <div className="top-actions">
          <div className="search-box">
            <span>⌕</span>
            <input
              type="search"
              placeholder="Search courses or tasks..."
              value={search}
              onChange={(event) => setSearch(event.target.value)}
            />
          </div>

          <button
            className="notification"
            title={`${pendingTasks} pending tasks`}
            aria-label={`${pendingTasks} pending tasks`}
          >
            🔔
            {pendingTasks > 0 && (
              <span className="notification-count">
                {pendingTasks}
              </span>
            )}
          </button>

          <button
            className="theme-btn"
            onClick={() => setDarkMode(!darkMode)}
          >
            {darkMode ? "☀️" : "🌙"}
          </button>

          <div className="profile">
            {imageError ? (
              <div className="avatar-fallback">ST</div>
            ) : (
              <img
                src="/images/profile.jpg"
                alt="Student profile"
                onError={() => setImageError(true)}
              />
            )}
            <span>Student</span>
          </div>
        </div>
      </header>

      <div className="layout">
        <aside className={`sidebar ${menuOpen ? "open" : ""}`}>
          <p className="side-title">MENU</p>
          <a href="#home" onClick={() => setMenuOpen(false)}>🏠 Home</a>
          <a href="#courses" onClick={() => setMenuOpen(false)}>📚 My Courses</a>
          <a href="#progress" onClick={() => setMenuOpen(false)}>📊 Progress</a>
          <a href="#tasks" onClick={() => setMenuOpen(false)}>✅ My Tasks</a>
          <a href="#profile" onClick={() => setMenuOpen(false)}>👤 Profile</a>

          <div className="sidebar-note">
            <h3>Keep Learning!</h3>
            <p>Small steps every day lead to big results.</p>
          </div>
        </aside>

        {menuOpen && (
          <button
            className="overlay"
            aria-label="Close navigation menu"
            onClick={() => setMenuOpen(false)}
          />
        )}

        <main className="dashboard">
          <section className="welcome" id="home">
            <p className="eyebrow">STUDENT OVERVIEW</p>
            <h1>Welcome Back! URK24CS1166</h1>
            <p>Track your courses, progress, and daily tasks.</p>
          </section>

          <section className="stats">
            <div className="stat-card purple">
              <span>📚</span>
              <p>Total Courses</p>
              <h2>4</h2>
            </div>

            <div className="stat-card blue">
              <span>📝</span>
              <p>Total Tasks</p>
              <h2>{tasks.length}</h2>
            </div>

            <div className="stat-card green">
              <span>✅</span>
              <p>Completed Tasks</p>
              <h2>{completedTasks}</h2>
            </div>

            <div className="stat-card orange">
              <span>⏳</span>
              <p>Pending Tasks</p>
              <h2>{pendingTasks}</h2>
            </div>
          </section>

          <section className="panel" id="courses">
            <div className="section-heading">
              <div>
                <h2>My Courses</h2>
                <p>Monitor your course completion.</p>
              </div>
            </div>

            <div className="course-grid">
              {filteredCourses.map((course) => (
                <div className="course-card" key={course.name}>
                  <div className="course-icon">📘</div>
                  <h3>{course.name}</h3>

                  <div className="progress-info">
                    <span>Course Progress</span>
                    <strong>{course.progress}%</strong>
                  </div>

                  <div
                    className="progress-track"
                    role="progressbar"
                    aria-label={`${course.name} completion`}
                    aria-valuenow={course.progress}
                    aria-valuemin={0}
                    aria-valuemax={100}
                  >
                    <div
                      className="progress-fill"
                      style={{ width: `${course.progress}%` }}
                    />
                  </div>
                </div>
              ))}
            </div>

            {filteredCourses.length === 0 && (
              <p className="empty-message">No matching courses found.</p>
            )}
          </section>

          <section className="panel task-panel" id="tasks">
            <div className="section-heading">
              <div>
                <h2>My Tasks</h2>
                <p>Manage your daily activities.</p>
              </div>
            </div>

            <div className="task-form">
              <input
                type="text"
                placeholder="Enter a new task..."
                value={task}
                onChange={(event) => setTask(event.target.value)}
                onKeyDown={(event) => {
                  if (event.key === "Enter") addTask();
                }}
              />
              <button onClick={addTask}>+ Add Task</button>
            </div>

            <div className="task-list">
              {filteredTasks.map((item) => (
                <div className="task-item" key={item.id}>
                  <label className="task-label">
                    <input
                      type="checkbox"
                      checked={item.done}
                      onChange={() => toggleTask(item.id)}
                    />
                    <span className={item.done ? "task-done" : ""}>
                      {item.text}
                    </span>
                  </label>

                  <button
                    className="delete-btn"
                    onClick={() => deleteTask(item.id)}
                    aria-label={`Delete ${item.text}`}
                    title="Delete task"
                  >
                    🗑️
                  </button>
                </div>
              ))}

              {filteredTasks.length === 0 && (
                <p className="empty-message">No matching tasks found.</p>
              )}
            </div>
          </section>

          <footer id="progress">
            EduDashboard · Learn, improve, and achieve.
          </footer>
        </main>
      </div>
    </div>
  );
}

export default App;

