const http = require('http');
const fs = require('fs');
const path = require('path');
const { MongoClient } = require('mongodb');

const client = new MongoClient(
    'mongodb://127.0.0.1:27017'
);

function escapeHTML(value) {
    return String(value ?? '').replace(/[&<>"']/g, char => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
    })[char]);
}

async function startServer() {
    await client.connect();

    const db = client.db('tourismDB');
    const tourists = db.collection('tourists');

    const server = http.createServer((req, res) => {
        if (req.method === 'GET' && req.url === '/') {
            res.writeHead(200, {
                'Content-Type': 'text/html; charset=utf-8'
            });

            fs.createReadStream(
                path.join(__dirname, 'home.html')
            ).pipe(res);

        } else if (
            req.method === 'POST' &&
            req.url === '/server'
        ) {
            let rawData = '';

            req.on('data', chunk => {
                rawData += chunk;
            });

            req.on('end', async () => {
                try {
                    const form = new URLSearchParams(rawData);

                    const name = form.get('name') || '';
                    const password = form.get('password') || '';
                    const age = Number(form.get('age'));
                    const mobile = form.get('mobile') || '';
                    const email = form.get('email') || '';
                    const gender = form.get('gender') || '';
                    const state = form.get('state') || '';
                    const destination =
                        form.get('destination') || '';
                    const skills = form.getAll('skills');

                    if (
                        !/^[A-Za-z ]{2,50}$/.test(name) ||
                        password.length < 6 ||
                        !Number.isInteger(age) ||
                        age < 1 || age > 120 ||
                        !/^[0-9]{10}$/.test(mobile) ||
                        !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ||
                        !['Male', 'Female', 'Other'].includes(gender) ||
                        !state || !destination ||
                        skills.length === 0 ||
                        skills.some(s => ![
                            'Adventure', 'Nature',
                            'Beaches', 'Heritage'
                        ].includes(s))
                    ) {
                        res.writeHead(400, {
                            'Content-Type': 'text/html; charset=utf-8'
                        });
                        return res.end(
                            '<h2>Invalid details. Please go back and check the form.</h2>'
                        );
                    }

                    const tourist = {
                        name,
                        password,
                        age,
                        mobile,
                        email,
                        gender,
                        state,
                        destination,
                        skills,
                        registeredAt: new Date()
                    };

                    await tourists.insertOne(tourist);

                    const rows = [
                        ['Name', name],
                        ['Age', age],
                        ['Mobile Number', mobile],
                        ['Email', email],
                        ['Gender', gender],
                        ['State', state],
                        ['Destination', destination],
                        ['Travel Interests', skills.join(', ')],
                        ['Registration Date',
                            tourist.registeredAt.toLocaleString()]
                    ];

                    const tableRows = rows.map(([key, value]) =>
                        `<tr>
                            <th>${escapeHTML(key)}</th>
                            <td>${escapeHTML(value)}</td>
                        </tr>`
                    ).join('');

                    res.writeHead(200, {
                        'Content-Type': 'text/html; charset=utf-8'
                    });

                    res.end(`
                        <!DOCTYPE html>
                        <html lang="en">
                        <head>
                            <meta charset="UTF-8">
                            <meta name="viewport"
                                  content="width=device-width, initial-scale=1.0">
                            <title>Registration Successful</title>
                            <style>
                                body {
                                    font-family: Arial, sans-serif;
                                    background: #e0f2fe;
                                    padding: 20px;
                                }
                                .container {
                                    max-width: 750px;
                                    margin: 30px auto;
                                    padding: 25px;
                                    background: white;
                                    border-radius: 12px;
                                }
                                h1 {
                                    text-align: center;
                                    color: #075985;
                                }
                                table {
                                    width: 100%;
                                    border-collapse: collapse;
                                }
                                th, td {
                                    border: 1px solid #cbd5e1;
                                    padding: 12px;
                                    text-align: left;
                                    overflow-wrap: anywhere;
                                }
                                th {
                                    background: #075985;
                                    color: white;
                                }
                                a {
                                    display: block;
                                    margin-top: 20px;
                                    text-align: center;
                                }
                            </style>
                        </head>
                        <body>
                            <div class="container">
                                <h1>Registration Successful!</h1>
                                <p>Your details have been saved.</p>
                                <table>${tableRows}</table>
                                <a href="/">Register Another Tourist</a>
                            </div>
                        </body>
                        </html>
                    `);

                } catch (error) {
                    console.error(error);
                    if (!res.headersSent) {
                        res.writeHead(500, {
                            'Content-Type': 'text/plain'
                        });
                    }
                    res.end('Unable to process registration.');
                }
            });

        } else {
            res.writeHead(404, {
                'Content-Type': 'text/plain'
            });
            res.end('Page not found');
        }
    });

    server.listen(7000, () => {
        console.log(
            'Tourism server running at http://localhost:7000'
        );
    });
}

startServer().catch(error => {
    console.error('Unable to start server:', error);
});

