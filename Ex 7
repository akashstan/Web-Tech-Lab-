3) Car Workshop

<!DOCTYPE html>
<html>
<head>
<title>Car Workshop</title>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<style>
body{
    margin:0;font-family:Arial;text-align:center;
    background:linear-gradient(135deg,#e0f2fe,#eef2ff)
}
.card{
    width:650px;margin:45px auto;padding:25px;
    background:white;border-radius:18px;
    box-shadow:0 15px 40px #0002
}
h2{color:#2563eb}
.car{
    position:relative;width:260px;height:120px;
    margin:40px auto
}
.body{
    width:210px;height:55px;background:#2563eb;
    position:absolute;bottom:30px;left:25px;
    border-radius:8px
}
.roof{
    width:120px;height:45px;background:#60a5fa;
    position:absolute;top:5px;left:70px;
    border-radius:45px 45px 0 0
}
.wheel{
    width:42px;height:42px;background:#111827;
    border-radius:50%;position:absolute;bottom:8px
}
.w1{left:45px}.w2{right:45px}
button{
    padding:10px 15px;margin:7px;border:1px solid #93c5fd;
    background:white;color:#2563eb;border-radius:7px;cursor:pointer
}
</style>
</head>

<body>
<div class="card">
<h2>🚗 Car Workshop</h2>

<div class="car">
<div class="roof" id="roof"></div>
<div class="body" id="body"></div>
<div class="wheel w1" id="w1"></div>
<div class="wheel w2" id="w2"></div>
</div>

<button id="color">Change Body Color</button>
<button id="glass">Change Glass Color</button>
<button id="tyre">Increase Tyre Size</button>
<button id="reset">Reset</button>
</div>

<script>
let colors=["#2563eb","#dc2626","#16a34a","#9333ea"];

$("#color").click(function(){
    let c=colors[Math.floor(Math.random()*colors.length)];
    $("#body").css("background",c);
});

$("#glass").click(function(){
    $("#roof").css("background",
        $("#roof").css("background-color")=="rgb(96, 165, 250)"?"#111827":"#60a5fa");
});

$("#tyre").click(function(){
    $(".wheel").animate({width:"52px",height:"52px"},300);
});

$("#reset").click(function(){
    $("#body").css("background","#2563eb");
    $("#roof").css("background","#60a5fa");
    $(".wheel").animate({width:"42px",height:"42px"},300);
});
</script>
</body>
</html>

