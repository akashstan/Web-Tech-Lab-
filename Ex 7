<!DOCTYPE html>
<html>
<head>
<title>Product Effects</title>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<style>
*{box-sizing:border-box}
body{
    margin:0;font-family:Arial;
    background:linear-gradient(135deg,#0f172a,#312e81);
    color:white;text-align:center
}
.container{width:700px;margin:50px auto}
h1{margin-bottom:25px}
#product{
    background:white;color:#172033;
    padding:25px;border-radius:18px;
    box-shadow:0 20px 50px #0006;
    width:430px;margin:20px auto
}
.price{font-size:25px;color:#4f46e5;font-weight:bold}
.badge{
    display:inline-block;padding:6px 12px;
    background:#dcfce7;color:#15803d;border-radius:20px
}
button{
    padding:10px 15px;margin:5px;
    border:0;border-radius:8px;cursor:pointer
}
.status{margin:15px;color:#c4b5fd;font-weight:bold}
</style>
</head>

<body>
<div class="container">
<h1>💻 Product Effects Lab</h1>

<div id="product">
<h2>Laptop Pro</h2>
<div class="price">₹65,000</div>
<p>Category: Electronics</p>
<span class="badge">Available</span>
<p id="details">Powerful laptop designed for professional work and daily productivity.</p>
</div>

<div>
<button id="show">Show</button>
<button id="hide">Hide</button>
<button id="fade">Fade</button>
<button id="slide">Slide</button>
<button id="animate">Animate</button>
<button id="stop">Stop</button>
<button id="callback">Callback</button>
<button id="chain">Chaining</button>
</div>

<div class="status" id="msg"></div>
</div>

<script>
$("#show").click(()=>$("#product").show());
$("#hide").click(()=>$("#product").hide());
$("#fade").click(()=>$("#product").fadeToggle(500));
$("#slide").click(()=>$("#details").slideToggle(500));

$("#animate").click(()=>{
    $("#product").animate({width:"520px",marginTop:"50px"},700);
});

$("#stop").click(()=>$("#product").stop());

$("#callback").click(()=>{
    $("#product").fadeOut(500,function(){
        $("#msg").text("✓ Animation completed successfully");
        $("#product").fadeIn(500);
    });
});

$("#chain").click(()=>{
    $("#product").slideUp(400).slideDown(400)
                 .fadeOut(400).fadeIn(400);
});
</script>
</body>
</html>

5) Employee Management

<!DOCTYPE html>
<html>
<head>
<title>Employee Dashboard</title>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<style>
*{box-sizing:border-box}
body{
    margin:0;font-family:Arial;
    background:linear-gradient(135deg,#eef2ff,#dbeafe);
    color:#172554
}
.dashboard{
    width:850px;margin:35px auto;background:white;
    padding:25px;border-radius:20px;
    box-shadow:0 20px 50px #0002
}
header{
    background:linear-gradient(90deg,#1e1b4b,#4f46e5);
    color:white;padding:20px;border-radius:15px
}
.form{
    display:flex;gap:8px;margin:20px 0
}
input{
    padding:11px;border:1px solid #cbd5e1;
    border-radius:7px;flex:1
}
button{
    padding:10px 15px;border:0;border-radius:7px;
    background:#4f46e5;color:white;cursor:pointer
}
table{
    width:100%;border-collapse:collapse;
    overflow:hidden;border-radius:10px
}
th{background:#1e1b4b;color:white;padding:12px}
td{padding:11px;border-bottom:1px solid #e2e8f0}
tr.selected{background:#ddd6fe;font-weight:bold}
.actions button{background:#0f766e}
#status{
    margin-top:15px;padding:10px;
    background:#f1f5f9;border-radius:8px
}
</style>
</head>

<body>
<div class="dashboard">

<header>
<h1>Employee Management</h1>
<p>HR Organization Dashboard</p>
</header>

<div class="form">
<input id="id" placeholder="Employee ID">
<input id="name" placeholder="Employee Name">
<input id="dept" placeholder="Department">
<button id="add">Add</button>
<button id="update">Update</button>
</div>

<table id="empTable">
<thead>
<tr><th>ID</th><th>Name</th><th>Department</th><th>Action</th></tr>
</thead>
<tbody>
<tr><td>101</td><td>Riya</td><td>HR</td><td><button class="remove">Remove</button></td></tr>
<tr><td>102</td><td>Arjun</td><td>IT</td><td><button class="remove">Remove</button></td></tr>
<tr><td>103</td><td>Meera</td><td>Finance</td><td><button class="remove">Remove</button></td></tr>
</tbody>
</table>

<br>
<button id="dimension">Show Table Dimensions</button>
<button id="style">Change Panel</button>

<div id="status">Select an employee to load details.</div>
</div>

<script>
let selected;

$("#empTable tbody").on("click","tr",function(){
    selected=$(this).addClass("selected").siblings().removeClass("selected");
    $("#id").val(selected.children().eq(0).text());
    $("#name").val(selected.children().eq(1).text());
    $("#dept").val(selected.children().eq(2).text());
    $("#status").text("Selected employee details loaded.");
});

$("#add").click(function(){
    $("#empTable tbody").append(
      `<tr><td>${$("#id").val()}</td><td>${$("#name").val()}</td>
       <td>${$("#dept").val()}</td><td><button class="remove">Remove</button></td></tr>`
    );
    $("#status").text("Employee added successfully.");
});

$("#update").click(function(){
    if(selected){
        selected.children().eq(0).text($("#id").val());
        selected.children().eq(1).text($("#name").val());
        selected.children().eq(2).text($("#dept").val());
        $("#status").text("Employee updated successfully.");
    }
});

$("#empTable").on("click",".remove",function(e){
    e.stopPropagation();
    $(this).closest("tr").remove();
    $("#status").text("Employee removed successfully.");
});

$("#dimension").click(function(){
    $("#status").text(
      "Table Width: "+$("#empTable").width()+
      "px | Height: "+$("#empTable").height()+"px"
    );
});

$("#style").click(function(){
    $("#status").css({
        background:"#4f46e5",
        color:"white",
        transition:"0.3s"
    });
});
</script>
</body>
</html>

6) jQuery Traversing

<!DOCTYPE html>
<html>
<head>
<title>Organization Explorer</title>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<style>
*{box-sizing:border-box}
body{
    margin:0;font-family:Arial;
    background:linear-gradient(135deg,#111827,#312e81);
    color:white
}
.app{width:900px;margin:35px auto}
header{
    padding:22px;background:#ffffff12;
    border:1px solid #ffffff20;border-radius:18px;
    backdrop-filter:blur(10px)
}
.project{
    margin-top:20px;padding:20px;
    background:#ffffff10;border-radius:15px
}
.team{
    display:inline-block;vertical-align:top;
    width:46%;margin:1.5%;padding:15px;
    background:white;color:#172033;
    border-radius:14px
}
.employee{
    padding:10px;margin:7px 0;
    background:#eef2ff;border-radius:8px;
    cursor:pointer
}
.employee:hover,.active{
    background:#c4b5fd;font-weight:bold
}
button{
    padding:9px 13px;margin:5px;
    border:0;border-radius:7px;
    background:#8b5cf6;color:white;cursor:pointer
}
#result{
    margin-top:15px;padding:15px;
    background:#ffffff12;border-radius:12px;
    min-height:45px
}
</style>
</head>

<body>
<div class="app">

<header>
<h1>Organization Explorer</h1>
<p>Interactive Employee Traversing Dashboard</p>
</header>

<div class="project" id="project">
<h2>Project Alpha</h2>

<div class="team">
<h3>Development Team</h3>
<div class="employee" data-senior="no">Arun - Developer</div>
<div class="employee" data-senior="yes">Kavya - Senior Developer</div>
<div class="employee" data-senior="no">Rahul - Developer</div>
</div>

<div class="team">
<h3>Testing Team</h3>
<div class="employee" data-senior="no">Meena - Tester</div>
<div class="employee" data-senior="yes">Priya - Senior Tester</div>
<div class="employee" data-senior="no">Karthik - Tester</div>
</div>
</div>

<div>
<button id="select">Select Employee</button>
<button id="parent">Show Parent Team</button>
<button id="ancestors">Show All Ancestors</button>
<button id="desc">Show Project Employees</button>
<button id="siblings">Show Teammates</button>
<button id="senior">Show Senior Employees</button>
<button id="reset">Reset</button>
</div>

<div id="result">Click an employee to begin.</div>
</div>

<script>
let emp;

$(".employee").click(function(){
    emp=$(this);
    $(".employee").removeClass("active");
    emp.addClass("active");
    $("#result").text("Selected Employee: "+emp.text());
});

$("#select").click(()=>$("#result").text("Selected Employee: "+(emp?emp.text():"None")));

$("#parent").click(function(){
    $(".team").css("outline","none");
    if(emp){
        emp.parent().css("outline","3px solid #a78bfa");
        $("#result").text("Parent Team: "+emp.parent().children("h3").text());
    }
});

$("#ancestors").click(function(){
    if(emp){
        emp.parents(".team,.project").css("outline","3px solid #22d3ee");
        $("#result").text("Ancestors highlighted: Team and Project Alpha");
    }
});

$("#desc").click(function(){
    $(".employee").removeClass("active");
    $("#project").find(".employee").addClass("active");
    $("#result").text("All employees in Project Alpha highlighted.");
});

$("#siblings").click(function(){
    $(".employee").removeClass("active");
    if(emp){
        emp.siblings(".employee").addClass("active");
        $("#result").text("Teammates highlighted.");
    }
});

$("#senior").click(function(){
    $(".employee").removeClass("active");
    $(".employee").filter("[data-senior='yes']").addClass("active");
    $("#result").text("Senior employees highlighted: Kavya and Priya");
});

$("#reset").click(function(){
    $(".employee,.team,.project").removeClass("active").css("outline","none");
    $("#result").text("View reset successfully.");
});
</script>
</body>
</html>

