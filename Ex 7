1) Budget Calculator

<!DOCTYPE html>
<html>
<head>
<title>Budget Calculator</title>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<style>
*{box-sizing:border-box}
body{
    margin:0;font-family:Arial;text-align:center;
    background:linear-gradient(135deg,#e0e7ff,#f0f9ff);
    color:#172554
}
.box{
    width:760px;margin:45px auto;padding:25px;
    background:white;border-radius:18px;
    box-shadow:0 15px 40px #0002
}
h2{
    margin:-25px -25px 25px;padding:14px;
    color:white;background:linear-gradient(90deg,#172554,#2563eb);
    border-radius:18px 18px 0 0
}
input{
    width:60px;padding:8px;text-align:center;
    border:1px solid #94a3b8;border-radius:5px
}
.amount{width:130px}
.percent{
    display:flex;justify-content:center;
    gap:18px;white-space:nowrap
}
button{
    padding:10px 25px;border:0;border-radius:7px;
    background:#172554;color:white
}
.parts{
    display:flex;justify-content:center;
    gap:12px;margin-top:25px
}
.part{
    width:140px;padding:13px 5px;color:white;
    border-radius:10px;font-weight:bold
}
.r{background:#2563eb}.a{background:#16a34a}
.e{background:#7c3aed}.s{background:#ec4899}
</style>
</head>

<body>

<div class="box">
<h2>Budget Calculator App</h2>

<b>Enter Amount You Want to Manage</b><br><br>
<input class="amount" id="amount" value="15000">

<p><b>How would you like to divide your money?</b></p>

<div class="percent">
<label>Room Rent (%) <input id="room" value="50"></label>
<label>Accessories (%) <input id="access" value="20"></label>
<label>Emergency (%) <input id="emergency" value="20"></label>
<label>Saving (%) <input id="saving" value="10"></label>
</div>

<br>
<button id="calc">Evaluate My Money</button>

<div class="parts">
<div class="part r">ROOM RENT<br>₹<span id="r">0</span></div>
<div class="part a">ACCESSORIES<br>₹<span id="a">0</span></div>
<div class="part e">EMERGENCY<br>₹<span id="e">0</span></div>
<div class="part s">SAVING<br>₹<span id="s">0</span></div>
</div>
</div>

<script>
$("#calc").click(function(){
    let a=+$("#amount").val(),
        p=[$("#room").val(),$("#access").val(),
           $("#emergency").val(),$("#saving").val()];

    if(p.reduce((x,y)=>+x + +y,0)!=100)
        return alert("Percentage values must total 100%.");

    ["#r","#a","#e","#s"].forEach((id,i)=>
        $(id).text(a*p[i]/100));
});
</script>

</body>
</html>

2) Cake Shop

<!DOCTYPE html>
<html>
<head>
<title>Cake Shop</title>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<style>
*{box-sizing:border-box}
body{
    margin:0;font-family:Arial;text-align:center;color:#3b1725;
    background:linear-gradient(135deg,#3b0a24,#8b3a50,#f8d7c4);
