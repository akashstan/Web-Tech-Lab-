    background:linear-gradient(90deg,#7c2d4f,#be185d);
    color:white;font-weight:bold;cursor:pointer;
}
.bill{
    margin-top:18px;padding:14px;background:#fce7f3;
    border-radius:12px;
}
.total{font-size:24px;font-weight:bold;margin-top:5px}
</style>
</head>

<body>

<div class="shop">

<h1>🍰 CAKE SHOP</h1>

<div class="cakes">
<div class="cake"><img src="color cake.jpg">Color Cake<br><b>₹300</b></div>
<div class="cake"><img src="brown cake.jpg">Brown Cake<br><b>₹200</b></div>
<div class="cake"><img src="milky cake.jpg">Milky Cake<br><b>₹250</b></div>
<div class="cake"><img src="black forest cake.jpg">Black Forest<br><b>₹350</b></div>
</div>

<h2>Order Cake</h2>

<div class="order">
<div class="row">Color Cake <input id="c" value="2"></div>
<div class="row">Brown Cake <input id="b" value="1"></div>
<div class="row">Milky Cake <input id="m" value="2"></div>
<div class="row">Black Forest <input id="f" value="1"></div>
