<!DOCTYPE html>
<html>
<head>
    <title>JavaScript Timer & Arrays</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial;
            background: #eef2ff;
            color: #1e293b;
        }

        header {
            background: #312e81;
            color: white;
            text-align: center;
            padding: 25px;
        }

        .container {
            width: 90%;
            max-width: 900px;
            margin: 25px auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 18px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 14px;
            box-shadow: 0 4px 12px #0002;
        }

        h2 {
            color: #312e81;
            margin-top: 0;
        }

        #time {
            font-size: 35px;
            text-align: center;
            color: #4f46e5;
        }

        #para {
            padding: 15px;
            background: #eef2ff;
            border-radius: 8px;
            text-align: center;
        }

        button {
            border: 0;
            padding: 9px 18px;
            border-radius: 7px;
            background: #4f46e5;
            color: white;
            cursor: pointer;
            margin: 4px;
        }

        #stop {
            background: #dc2626;
        }

        .student {
            padding: 10px;
            margin: 8px 0;
            background: #f1f5f9;
            border-radius: 7px;
        }

        footer {
            text-align: center;
            background: #312e81;
            color: white;
            padding: 12px;
        }
    </style>
</head>

<body onload="init()">

    <header>
        <h1>JavaScript Timer & Arrays</h1>
        <p>Interactive Web Demonstration</p>
    </header>

    <div class="container">

        <div class="card">
            <h2>🕐 Digital Clock</h2>
            <div id="time"></div>
        </div>

        <div class="card">
            <h2>🎨 Dynamic Background</h2>
            <p>Background changes every 30 seconds automatically.</p>
        </div>

        <div class="card">
            <h2>🔍 Font Size</h2>
            <p id="para"
               onmouseover="zoom(28)"
               onmouseout="zoom(16)">
                Move cursor over me to zoom
            </p>
        </div>

        <div class="card">
            <h2>🚗 Move Car</h2>
            <img id="car" src="car.jpg" width="130">
            <br>
            <button onclick="move()">▶ Move</button>
            <button id="stop" onclick="clearTimeout(t)">■ Stop</button>
        </div>

        <div class="card">
            <h2>👨‍🎓 Student Details</h2>
            <div id="students"></div>
        </div>

    </div>

    <footer>
        JavaScript Timer & Arrays
    </footer>

    <script>
        // 1. Digital Clock
        function clock() {
            let d = new Date();
            time.innerHTML = d.toLocaleTimeString();
        }

        clock();
        setInterval(clock, 1000);

        // 2. Background Colour
        setInterval(() => {
            document.body.style.background =
                `rgb(${Math.random() * 256},
                ${Math.random() * 256},
                ${Math.random() * 256})`;
        }, 30000);

        // 3. Font Size
        function zoom(size) {
            para.style.fontSize = size + "px";
        }

        // 4. Move Car
        let t;

        function init() {
            car.style.position = "relative";
            car.style.left = "0px";
        }

        function move() {
            car.style.left = parseInt(car.style.left) + 5 + "px";
            t = setTimeout(move, 20);
        }

        // 5. Student Array
        let data = [
            ["John", "UR13CS129", 1995],
            ["Joseph", "UR13CS130", 2002],
            ["David", "UR13CS131", 1998]
        ];

        data.forEach(s => {
            students.innerHTML +=
                `<div class="student">
                    <b>${s[0]}</b> - ${s[1]} |
                    ${s[2] < 2000 ? "Before 2000" : "After 2000"}
                </div>`;
        });
    </script>

</body>
</html>
